# Copy to .env and adjust. Defaults to a local SQLite file when unset.
#
# SQLite (zero-config local dev — tables auto-created on startup):
# DATABASE_URL=sqlite:///./saas_products.db
#
# Postgres (managed by Alembic — run `alembic upgrade head` after starting it):
# DATABASE_URL=postgresql://saas:saas@localhost:5432/saas_products

DATABASE_URL=sqlite:///./saas_products.db

# Authentication & rate limiting (both optional, disabled by default).
# Comma-separated keys; clients send one in the `X-API-Key` header.
# API_KEYS=local-dev-key,another-key
# Requests per identity per window (0 disables rate limiting).
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_WINDOW_SECONDS=60
